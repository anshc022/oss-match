# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/oss-match
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oss-match
MONGODB_URI=

# NextAuth. Generate the secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Sign-in: GitHub OAuth App ---------------------------------------------
# https://github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Only the read:user and user:email scopes are ever requested.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Background fetching: GitHub App ---------------------------------------
# Used only by the scheduled fetcher, never by a user request. An App
# installation gets its own 5,000 requests/hour, independent of any user.
#
#   1. https://github.com/settings/apps/new
#   2. Permissions: Repository -> Metadata: Read-only, Issues: Read-only.
#      No write access is needed.
#   3. Generate a private key, then install the App on your account or org.
#   4. The installation id is the trailing number in the URL you land on:
#      https://github.com/settings/installations/<INSTALLATION_ID>
#
# The private key is a multi-line PEM. Either escape the newlines as \n or
# base64-encode the whole file; both are accepted.
#   base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Fallback for the fetcher when no GitHub App is configured. Any token with
# public read access; no scopes required. Without either, the fetcher runs
# unauthenticated at 60 requests/hour, which is not enough for a full cycle.
GITHUB_TOKEN=

# --- Scheduled job ----------------------------------------------------------
# Required. /api/cron/fetch-issues refuses to run unless this is set, and
# returns 404 to callers that do not present it.
#   openssl rand -hex 32
CRON_SECRET=

# --- Fetch cadence ----------------------------------------------------------
# The cron fires hourly (vercel.json); these decide which queries are due.
#   off:                  normal queries refresh every 3 hours
#   FETCH_BOOST_MODE:     normal queries refresh every 1 hour
#   HACKTOBERFEST_MODE:   implies boost, adds the "hacktoberfest" label to the
#                         query matrix, refreshes those every 30 minutes, and
#                         shows the Hacktoberfest badge and filter in the feed
FETCH_BOOST_MODE=false
HACKTOBERFEST_MODE=false

# --- AI features (optional) -------------------------------------------------
# Powers the computed skill graph and mentor suggestions through any
# OpenAI-compatible chat-completions endpoint. Without a key both features fall
# back to a heuristic built from the same GitHub activity data.
LLM_API_KEY=
LLM_BASE_URL=https://api.b.ai/v1
LLM_MODEL=glm-5.3-flash
